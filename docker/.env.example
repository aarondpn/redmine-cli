# Redmine instance and the API key the MCP server acts as
# (My account -> API access key in Redmine).
REDMINE_SERVER=https://redmine.example.com
REDMINE_API_KEY=

# Bearer token MCP clients must send. Generate one with: openssl rand -hex 32
REDMINE_MCP_AUTH_TOKEN=

# Register create/update/delete tools. Read-only when false.
REDMINE_MCP_ENABLE_WRITES=false

# Optional: restrict the exposed tools (see `redmine mcp tools`).
# REDMINE_MCP_ENABLE_GROUPS=issues,wiki
# REDMINE_MCP_DISABLE_TOOLS=delete_issue,delete_project

# Host address the server is published on. The default only accepts
# connections from this machine; use 0.0.0.0:8080 to expose it on the network
# (ideally behind a TLS-terminating reverse proxy).
# REDMINE_MCP_PUBLISH=127.0.0.1:8080

# Pin a release instead of tracking latest, e.g. 2.13.0.
# REDMINE_MCP_IMAGE_TAG=latest
