#!/bin/sh
# Fixture extension for the MCP tests. What it prints depends on the
# command it runs as (REDMINE_EXT_COMMAND).
set -u

# esc escapes a value for a JSON string.
esc() {
	printf '%s' "$1" | awk 'BEGIN { ORS = "" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); if (NR > 1) print "\\n"; print }'
}

input=$(cat)

case "${REDMINE_EXT_COMMAND:-}" in
list)
	printf '[{"id":1,"api_key":"list-secret"},{"id":2,"user":{"api_key":"nested-secret","login":"jdoe"}}]\n'
	exit 0
	;;
text)
	printf 'plain text\n'
	exit 0
	;;
empty)
	exit 0
	;;
fail)
	printf 'something went wrong\nboom\n' >&2
	exit 3
	;;
slow)
	sleep 5
	exit 0
	;;
esac

printf '{"api_key":"top-secret","user":{"api_key":"user-secret","login":"jdoe"},"stdin":'
if [ -n "$input" ]; then
	printf '%s' "$input"
else
	printf 'null'
fi
printf ',"env":{'
sep=""
for k in REDMINE_CLI_BIN REDMINE_EXT_NAME REDMINE_EXT_COMMAND REDMINE_EXT_SURFACE REDMINE_MCP REDMINE_MCP_TOOL \
	REDMINE_PROFILE REDMINE_CONFIG REDMINE_SERVER REDMINE_HEADERS REDMINE_READ_ONLY REDMINE_NO_COLOR \
	REDMINE_NO_UPDATE_CHECK; do
	eval "isset=\${$k+x}"
	if [ -n "$isset" ]; then
		eval "v=\$$k"
		printf '%s"%s":"%s"' "$sep" "$k" "$(esc "$v")"
		sep=","
	fi
done
printf '}}\n'
