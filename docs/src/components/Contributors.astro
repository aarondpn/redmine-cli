---
import SectionHead from './SectionHead.astro';

type Contributor = {
  login: string;
  id: number;
  avatar_url: string;
  html_url: string;
  contributions: number;
  type: string;
};

// Set in CI, where shared runner IPs exhaust the unauthenticated rate limit.
const token = process.env.GITHUB_TOKEN;
const headers: Record<string, string> = { Accept: 'application/vnd.github+json' };
if (token) headers.Authorization = `Bearer ${token}`;

let contributors: Contributor[] = [];
try {
  const res = await fetch(
    'https://api.github.com/repos/aarondpn/redmine-cli/contributors?per_page=50',
    { headers },
  );
  if (res.ok) {
    const data = (await res.json()) as Contributor[];
    contributors = data.filter((c) => c.type === 'User');
  }
} catch {
  contributors = [];
}

const totalCommits = contributors.reduce((a, c) => a + c.contributions, 0);
const t = Astro.locals.t;
---

<SectionHead
  title={t('home.contributors')}
  link={{ text: t('home.contribute'), href: 'https://github.com/aarondpn/redmine-cli' }}
/>

<div class="rc-crew not-content">
  {contributors.length === 0 ? (
    <p class="rc-crew__empty">
      {t('contributors.emptyBefore')}
      <a href="https://github.com/aarondpn/redmine-cli/graphs/contributors">{t('contributors.emptyLink')}</a>.
    </p>
  ) : (
    <>
      <p class="rc-crew__meta">
        {t('contributors.count', { count: contributors.length })}
        {totalCommits > 0 && <> · {t('contributors.commitCount', { count: totalCommits })}</>}
      </p>
      <ul class="rc-crew__grid">
        {contributors.map((c) => (
          <li class="rc-crew__item">
            <a class="rc-crew__link" href={c.html_url} target="_blank" rel="noopener" title={`@${c.login} — ${t('contributors.commitCount', { count: c.contributions })}`}>
              <img
                class="rc-crew__avatar"
                src={`${c.avatar_url}&s=128`}
                alt={`${c.login} avatar`}
                loading="lazy"
                width="56"
                height="56"
              />
              <span class="rc-crew__handle">@{c.login}</span>
              <span class="rc-crew__count">{t('contributors.commitCount', { count: c.contributions })}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</div>
