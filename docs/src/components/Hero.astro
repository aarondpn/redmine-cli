---
// Custom Starlight Hero override. Reads `hero` frontmatter from the current route
// and renders a full-bleed red poster hero: oversized headline on the left, pitch
// and actions on the right, the install bar below them, and the terminal demo
// straddling the bottom edge.
import Terminal from './Terminal.astro';
import StatusBar from './StatusBar.astro';
import InstallBar from './InstallBar.astro';

const { hero } = Astro.locals.starlightRoute.entry.data as {
  hero?: {
    tagline?: string;
    actions?: { text: string; link: string; variant?: string; icon?: string }[];
  };
};

const t = Astro.locals.t;
const tagline = hero?.tagline ?? '';
const actions = hero?.actions ?? [];
---

<section class="rc-hero not-content" aria-labelledby="rc-hero-title">
  <div class="rc-hero__poster rc-bleed">
    <div class="rc-hero__inner">
      <StatusBar />

      <div class="rc-hero__grid">
        <h1 id="rc-hero-title" class="rc-hero__title">
          <span>{t('hero.headline1')}</span>
          <span>{t('hero.headline2')}</span>
        </h1>

        <div class="rc-hero__side">
          <p class="rc-hero__lede">{t('hero.lede')}</p>
          <p class="rc-hero__tagline">{tagline || t('hero.fallbackTagline')}</p>

          {actions.length > 0 && (
            <div class="rc-hero__actions">
              {actions.map((a) => (
                <a
                  href={a.link}
                  class={`rc-btn ${a.variant === 'minimal' ? 'rc-btn--ghost' : 'rc-btn--primary'}`}
                >
                  <span class="rc-btn__label">{a.text}</span>
                  <span class="rc-btn__arrow" aria-hidden="true">
                    {a.variant === 'minimal' ? '↗' : '→'}
                  </span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <InstallBar />
    </div>
  </div>

  <div class="rc-hero__console rc-bleed">
    <div class="rc-hero__inner">
      <Terminal />
    </div>
  </div>
</section>
