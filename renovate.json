{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "3 days",
  "schedule": ["before 9am on monday"],
  "timezone": "Europe/Berlin",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in workflows behind a '# renovate:' comment",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:version|[A-Z0-9_]+_VERSION): \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "mcp-publisher is verified against a pinned sha256 that Renovate cannot compute",
      "matchDepNames": ["modelcontextprotocol/registry"],
      "prBodyNotes": [
        "Update `MCP_PUBLISHER_SHA256` in `.github/workflows/release.yml` to the sha256 of `mcp-publisher_linux_amd64.tar.gz` from this release's checksums file before merging; the MCP Registry publish job refuses a mismatched tarball."
      ]
    },
    {
      "description": "Immediately open PRs for vulnerability fixes",
      "matchCategories": ["security"],
      "schedule": ["at any time"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Group Go dependency updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go dependencies (non-major)"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group docs dependencies",
      "matchFileNames": ["docs/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docs dependencies (non-major)"
    }
  ]
}
